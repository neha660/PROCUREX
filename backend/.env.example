# Copy this file to .env and fill in your key to enable live LLM calls via
# OpenRouter (https://openrouter.ai/api/v1/chat/completions — one API key,
# hundreds of models: Gemini, Claude, GPT, Llama, and more).
# Leave OPENROUTER_API_KEY empty and ProcureX runs perfectly well on its
# deterministic offline mock (no external calls, no key needed) — useful
# for a hackathon demo with unreliable wifi.

# "~google/gemini-flash-latest" is a self-updating alias — the "~" makes it
# always resolve to the current Gemini Flash model, so it won't go stale.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=~google/gemini-flash-latest
