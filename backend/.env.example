# Copy this file to .env and fill in your key to enable live LLM calls
# via OpenRouter (https://openrouter.ai/keys).
# Leave OPENROUTER_API_KEY empty and ProcureX runs perfectly well on its
# deterministic offline mock (no external calls, no key needed) — useful
# for a hackathon demo with unreliable wifi.

OPENROUTER_API_KEY=
# "google/gemini-flash-latest" is a self-updating alias that always
# points at Google's current Gemini Flash model, so this default won't
# go stale when a newer version ships. Swap in any other OpenRouter
# model slug if you'd rather use Claude, GPT, Llama, etc.
OPENROUTER_MODEL=google/gemini-flash-latest
